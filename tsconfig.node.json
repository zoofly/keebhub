{
  // Build and test tooling that runs in Node.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // "dom" for the browser callbacks in e2e specs (page.evaluate).
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e",
    // The e2e seed reuses the mock fixtures (and the shared types they import).
    "src/client/mocks/fixtures.ts",
    "src/shared"
  ],
  "exclude": ["src/shared/**/*.test.ts"]
}
